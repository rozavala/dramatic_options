# Dramatic Options — the post-L1 measurement timer (#456 §10.12, #464 §10.13). TEMPLATE (no placeholders; installed
# + enabled by deploy.sh only where FORWARD_ENABLED=true, like the other timers; PROD stays installed-but-disabled).
#
# Mon..Fri 16:10 ET: after the 15:45 ET L1 (which measured ~7 min on 11-13; its TimeoutStartSec is 30 min, and the
# service's After= holds this start until a still-running L1 exits). Fires daily all year; each pass refuses quietly
# (exit 0) when it has nothing to do (disabled, before its segment, segment complete, no L1 today).
# Persistent=true: a run missed while the box was down fires on boot; a pass reads only if that ET day's L1 council
# exists and has finished, else it refuses quietly.
[Unit]
Description=Dramatic Options post-L1 measurement timer (Mon..Fri 16:10 ET, after the L1)

[Timer]
OnCalendar=Mon..Fri 16:10 America/New_York
Persistent=true
Unit=dramatic-options-post-l1.service

[Install]
WantedBy=timers.target
